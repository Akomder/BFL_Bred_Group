{
  "name": "bfl-cash-form-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Receives completed cash deposit/withdrawal forms, emails the PDF and archives it to Google Drive.",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --experimental-test-module-mocks --test \"src/**/*.test.js\"",
    "google:auth": "node --env-file-if-exists=.env scripts/google-oauth-setup.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5"
  }
}
