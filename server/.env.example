# Copy to .env and fill in. The Email and SharePoint sections below are
# REQUIRED — the service checks them at startup and refuses to run without
# working credentials for both (see the README's "Startup checks"). The
# Google Sheets section is the one optional piece.

PORT=8787
# Origins the tablets load the app from, comma separated.
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- Email
# Where every completed form is sent.
MAIL_TO=it.support@bfl.la
# Must be a real licensed mailbox — Microsoft Graph refuses to send as an alias.
MAIL_FROM=no-reply@bfl.la

# auto  = try Graph, fall back to the SMTP relay (recommended)
# graph = Graph only    smtp = relay only
MAIL_TRANSPORT=auto

# Graph sending reuses the SP_* app registration below by default; it needs the
# Mail.Send application permission added. Set these only to use a separate app.
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=

# SMTP relay — the fallback. Note that Microsoft 365 disables SMTP AUTH on most
# tenants, so this usually points at an internal gateway rather than at M365.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Delivery resilience.
MAIL_RETRY_ATTEMPTS=3
MAIL_RETRY_BASE_MS=400
MAIL_TIMEOUT_MS=15000

# ----------------------------------------------------------- SharePoint
# Microsoft Entra app registration with Files.ReadWrite.All (application).
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
# Target drive (document library) and the folder inside it.
SP_DRIVE_ID=
SP_FOLDER=CashForms

# Where undeliverable forms are spooled (outbox/spool) so that a submission is
# never lost if mail is briefly down. Nothing else writes here.
OUTBOX_DIR=outbox

# ------------------------------------------------------ Google Sheets (optional)
# Adds a searchable ledger row per submission, on top of the PDF archive and
# the audit email — not a replacement for either. Leave blank to skip it
# entirely; the service starts normally either way. See the README's
# "Transaction ledger" section for the setup steps (enable the Sheets API,
# create a service account, and share the target spreadsheet with it).
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the private_key value from the service account's JSON key as-is,
# including its literal \n sequences — they're unescaped automatically.
GOOGLE_SHEETS_PRIVATE_KEY=
# From the spreadsheet's URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Transactions
GOOGLE_SHEETS_TIMEOUT_MS=15000
