# Copy to .env and fill in. The Email and Google Drive sections below are
# REQUIRED — the service checks them at startup and refuses to run without
# working credentials for both (see the README's "Startup checks"). The
# Google Sheets section is the one optional piece — it reuses the same
# Google authorization as Drive, so nothing extra to create there.

PORT=8787
# Origins the tablets load the app from, comma separated. This is a browser
# convenience only — it is NOT access control, and never stopped a scripted
# client. The API keys below are what actually guard the endpoints.
ALLOWED_ORIGINS=http://localhost:5173

# --------------------------------------------------------------- API keys
# REQUIRED. Both lists are comma separated so a key can be rotated without
# downtime: add the new one, move the clients over, then drop the old one.
# Generate each with:  openssl rand -hex 32
#
# Leaving either blank does NOT disable the check — the matching endpoints
# refuse every request with 503. That is deliberate: a banking endpoint that
# forgot its credentials should stop, not open.

# Tablets. Sent as `Authorization: Bearer <key>` (or `X-API-Key: <key>`) on
# POST /api/submissions and GET /api/client-ip.
#
# NOTE: the tablet build inlines its key into the JavaScript bundle, so
# anyone who can load the app can read it. It is a deployment credential that
# keeps anonymous callers out — not a per-user secret. Keep the tablets on
# the branch network, give each deployment its own key, and rotate it if a
# device is lost.
API_KEYS=

# Support/IT. Guards GET /api/spool, POST /api/spool/flush and the detailed
# GET /api/health. Must NOT overlap with API_KEYS — the service refuses to
# boot if a tablet key would also grant spool access.
ADMIN_API_KEYS=

# ----------------------------------------------------------- Trust / limits
# How many reverse proxies sit in front of this service. Express uses it to
# decide how much of X-Forwarded-For to believe, which decides whether the IP
# recorded on a form is evidence or decoration. 0 = tablets connect directly
# and the header is ignored. Set the real proxy count (e.g. 1 behind nginx),
# or a specific proxy address/CIDR list, only once that is actually true.
#
# On the Vercel deployment this MUST be 1: the function always sits behind
# Vercel's proxy, so at 0 every caller's recorded IP is that proxy — the same
# wrong value on every audit mail, ledger row and PDF — and per-IP rate
# limiting collapses into one shared bucket.
TRUST_PROXY=0

# ------------------------------------------------------- Source-IP allowlist
# Only read by the edge middleware (middleware.js), i.e. the Vercel
# deployment. On the VPS, nginx enforces the equivalent (deploy.md §9.1) and
# these are ignored.
#
# This is the layer that makes the device key's visibility tolerable:
# VITE_API_KEY is inlined into the built bundle by design, so anyone who can
# load the app can read it. Without an allowlist in front, every /api/ route
# is reachable by anyone who views source.
#
# Comma-separated CIDRs or bare addresses, IPv4 or IPv6. Both fail closed —
# unset means deny, not allow. Do not widen either to 0.0.0.0/0 and lean on
# the device key alone; if branch egress is dynamic, use a VPN, an
# identity-aware proxy, or Vercel Firewall rules instead.
#
# Branch and VPN egress — guards every /api/ route.
ALLOWED_CIDRS=
# IT administration only — guards /api/spool and /api/spool/flush, which
# expose queued customer submissions and can trigger a mail flush.
ADMIN_CIDRS=

# Per-IP request ceilings. Each submission fans out into two emails, a Drive
# upload and a Sheets append, so an unthrottled endpoint turns a simple loop
# into mail volume and API quota burn.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_SUBMISSIONS=60
RATE_LIMIT_GENERAL=300

# ---------------------------------------------------------------- Email
# Where every completed form is sent.
MAIL_TO=it.support@bfl.la
# Must be a real mailbox. Gmail (and most providers) reject a send whose
# envelope sender doesn't match the authenticated account — keep this equal
# to SMTP_USER unless your relay is explicitly configured to allow otherwise.
MAIL_FROM=no-reply@bfl.la

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Delivery resilience.
MAIL_RETRY_ATTEMPTS=3
MAIL_RETRY_BASE_MS=400
MAIL_TIMEOUT_MS=15000

# ------------------------------------------------------------------ Google
# Two accepted credential shapes. google.js prefers the service account when
# both are present — a deployment given one was migrated on purpose, and
# quietly falling back to a personal grant left in the environment would undo
# that without saying so.
#
# PRODUCTION: service account + Shared Drive (deploy.md §4). Access belongs to
# the bank rather than to one employee's Google session, so nobody leaving
# takes the archive with them. Both values come from the service account's
# JSON key: `client_email` and `private_key`.
#
# Paste the private key exactly as it appears in the JSON, on one line with
# its \n sequences intact and wrapped in quotes — config.js restores the real
# newlines. Anything that reaches Drive or Sheets goes through this key, so it
# is the single most sensitive value in this file.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# LOCAL DEVELOPMENT: personal OAuth. The app acts as whichever Google account
# ran `npm run google:auth`. Leave these blank once the service account above
# is live — deploy.md §11-D revokes the grant outright.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_TIMEOUT_MS=15000

# The target folder's ID (from its Drive URL) — any folder you already own.
# No sharing step needed: the app authenticates as you, so it already has
# whatever access you have.
GOOGLE_DRIVE_FOLDER_ID=

# Where undeliverable forms are spooled (outbox/spool) so that a submission is
# never lost if mail is briefly down. Nothing else writes here.
# Used by SPOOL_DRIVER=fs only.
OUTBOX_DIR=outbox

# Which store backs that promise.
#
#   fs    (default) a directory this process owns. Correct anywhere the disk
#         outlives the request — the VPS under systemd, and local dev.
#   blob  Vercel Blob. Required on the serverless deployment, whose filesystem
#         is read-only apart from /tmp, and whose /tmp is destroyed when the
#         container recycles. Set OUTBOX_DIR aside and connect a Blob store to
#         the project; BLOB_READ_WRITE_TOKEN is then injected automatically and
#         the service refuses to start without it.
#
# Getting this wrong on a serverless host does not fail loudly — it silently
# discards forms a customer has already submitted and walked away from.
SPOOL_DRIVER=fs

# ------------------------------------------------------ Google Sheets (optional)
# Adds a searchable ledger row per submission, on top of the PDF archive and
# the audit email — not a replacement for either. Leave blank to skip it
# entirely; the service starts normally either way. Same account as Drive
# above, no separate authorization needed — just a spreadsheet you already own.
# From the spreadsheet's URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Transactions
