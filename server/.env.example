# Copy to .env and fill in. Every value is optional: with none of them set the
# service writes into ./outbox instead of emailing and uploading, which is how
# the demo runs.

PORT=8787
# Origins the tablets load the app from, comma separated.
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- Email
# Where every completed form is sent.
MAIL_TO=it.support@bfl.la
# Must be a real licensed mailbox — Microsoft Graph refuses to send as an alias.
MAIL_FROM=no-reply@bfl.la

# auto  = try Graph, fall back to the SMTP relay (recommended)
# graph = Graph only    smtp = relay only
MAIL_TRANSPORT=auto

# Graph sending reuses the SP_* app registration below by default; it needs the
# Mail.Send application permission added. Set these only to use a separate app.
MAIL_GRAPH_TENANT_ID=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=

# SMTP relay — the fallback. Note that Microsoft 365 disables SMTP AUTH on most
# tenants, so this usually points at an internal gateway rather than at M365.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Delivery resilience.
MAIL_RETRY_ATTEMPTS=3
MAIL_RETRY_BASE_MS=400
MAIL_TIMEOUT_MS=15000

# ----------------------------------------------------------- SharePoint
# Microsoft Entra app registration with Files.ReadWrite.All (application).
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
# Target drive (document library) and the folder inside it.
SP_DRIVE_ID=
SP_FOLDER=CashForms

# Where the local fallback adapters write, and where undeliverable forms are
# spooled (outbox/spool) so that none is ever lost.
OUTBOX_DIR=outbox
