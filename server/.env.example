# Copy to .env and fill in. The Email and SharePoint sections below are
# REQUIRED — the service checks them at startup and refuses to run without
# working credentials for both (see the README's "Startup checks"). The
# Excel ledger section is the one optional piece — it reuses the same
# Entra app registration as SharePoint, so nothing extra to create there.

PORT=8787
# Origins the tablets load the app from, comma separated. This is a browser
# convenience only — it is NOT access control, and never stopped a scripted
# client. The API keys below are what actually guard the endpoints.
ALLOWED_ORIGINS=http://localhost:5173

# --------------------------------------------------------------- API keys
# REQUIRED. Both lists are comma separated so a key can be rotated without
# downtime: add the new one, move the clients over, then drop the old one.
# Generate each with:  openssl rand -hex 32
#
# Leaving either blank does NOT disable the check — the matching endpoints
# refuse every request with 503. That is deliberate: a banking endpoint that
# forgot its credentials should stop, not open.

# Tablets. Sent as `Authorization: Bearer <key>` (or `X-API-Key: <key>`) on
# POST /api/submissions and GET /api/client-ip.
#
# NOTE: the tablet build inlines its key into the JavaScript bundle, so
# anyone who can load the app can read it. It is a deployment credential that
# keeps anonymous callers out — not a per-user secret. Keep the tablets on
# the branch network, give each deployment its own key, and rotate it if a
# device is lost.
API_KEYS=

# Support/IT. Guards GET /api/spool, POST /api/spool/flush and the detailed
# GET /api/health. Must NOT overlap with API_KEYS — the service refuses to
# boot if a tablet key would also grant spool access.
ADMIN_API_KEYS=

# ----------------------------------------------------------- Trust / limits
# How many reverse proxies sit in front of this service. Express uses it to
# decide how much of X-Forwarded-For to believe, which decides whether the IP
# recorded on a form is evidence or decoration. 0 = tablets connect directly
# and the header is ignored. Set the real proxy count (e.g. 1 behind nginx),
# or a specific proxy address/CIDR list, only once that is actually true.
TRUST_PROXY=0

# Per-IP request ceilings. Each submission fans out into two emails, a Drive
# upload and a Sheets append, so an unthrottled endpoint turns a simple loop
# into mail volume and API quota burn.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_SUBMISSIONS=60
RATE_LIMIT_GENERAL=300

# ---------------------------------------------------------------- Email
# Where every completed form is sent.
MAIL_TO=it.support@bfl.la
# Must be a real mailbox. Outlook/Microsoft 365 (and most providers) reject a
# send whose envelope sender doesn't match the authenticated account — keep
# this equal to SMTP_USER unless your relay is explicitly configured to allow
# otherwise.
MAIL_FROM=no-reply@bfl.la

# Microsoft 365 / Outlook SMTP:
#   Work or school account: smtp.office365.com
#   Personal outlook.com/hotmail.com account: smtp-mail.outlook.com
# Port 587 with SMTP_SECURE=false (STARTTLS, not implicit TLS).
# SMTP AUTH is often disabled by default on Microsoft 365 tenants — if auth
# fails citing "SmtpClientAuthenticationDisabled", a tenant admin has to
# enable it for this mailbox first. If the account has MFA on, SMTP_PASS
# must be an app password, not the normal sign-in password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Delivery resilience.
MAIL_RETRY_ATTEMPTS=3
MAIL_RETRY_BASE_MS=400
MAIL_TIMEOUT_MS=15000

# ---------------------------------------------------- SharePoint/OneDrive (required)
# The archive uploads via Microsoft Graph, authenticated as an Entra app
# registration (client-credentials grant) — not as any one user's account.
#
# 1. Azure Portal > App registrations > New registration.
# 2. API permissions > Add a permission > Microsoft Graph > Application
#    permissions > Files.ReadWrite.All (or Sites.ReadWrite.All for a
#    SharePoint site rather than a personal OneDrive) > Grant admin consent.
# 3. Certificates & secrets > New client secret. Copy its value immediately —
#    it is shown only once.
# 4. Copy the "Application (client) ID" and "Directory (tenant) ID" from the
#    registration's Overview page.
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=

# The drive ID PDFs (and the ledger workbook) are uploaded into — a OneDrive
# or a SharePoint document library. Find it via Graph Explorer:
#   GET https://graph.microsoft.com/v1.0/users/{upn}/drive          (OneDrive)
#   GET https://graph.microsoft.com/v1.0/sites/{site}/drive         (SharePoint)
# and read the "id" field of the response.
SP_DRIVE_ID=

# Parent folder within that drive PDFs are filed under, as <folder>/<YYYY>/<MM>/.
SP_FOLDER=CashForms

SP_TIMEOUT_MS=15000

# Where undeliverable forms are spooled (outbox/spool) so that a submission is
# never lost if mail is briefly down. Nothing else writes here.
OUTBOX_DIR=outbox

# ------------------------------------------------------------ Excel ledger (optional)
# Adds a searchable ledger row per submission, on top of the PDF archive and
# the audit email — not a replacement for either. Leave EXCEL_PATH blank to
# skip it entirely; the service starts normally either way.
#
# Create an .xlsx file in the same SharePoint/OneDrive drive as SP_DRIVE_ID
# above, add a header row, then Insert > Table over it and name the table
# (default below is "Transactions"). No separate authorization needed — the
# same app registration that archives PDFs writes these rows too.
EXCEL_PATH=
EXCEL_TABLE=Transactions
