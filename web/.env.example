# Copy to .env.local for `npm run dev`, or .env.production for `npm run build`.
# Vite inlines this at build time, so it must be set before building — there
# is no runtime fallback or demo mode without it.

# The submission service's address (server/, see its own .env.example).
# Tablets on the branch network reach it by hostname or LAN IP, not localhost.
VITE_API_BASE=http://localhost:8787

# The deployment credential the service requires on every call (server's
# API_KEYS list). Generate with `openssl rand -hex 32`.
#
# Vite inlines this into the built bundle, so anyone who can load the app can
# read it — it keeps anonymous callers off the API, it is not a per-user
# secret. Give each deployment its own key, keep the tablets on the branch
# network, and rotate the key if a device goes missing.
VITE_API_KEY=
